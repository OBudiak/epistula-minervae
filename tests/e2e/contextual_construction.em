nuntia structuram Box <<
    mutabilis integer value;
>>.
nuntia edictum Make quo cape integer input remitteque Box <<
    immutabilis variabilis Number <- input;
    reditus novum Number!
>>.
nuntia edictum Get quo cape Box box remitteque integer <<
    reditus box.value!
>>.
Box box <- Make(3).
box <- novum 5.
Scribe box, ",", Get(novum 7), "/linea".
