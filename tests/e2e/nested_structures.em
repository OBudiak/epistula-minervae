nuntia structuram Outer <<
    nuntia structuram Inner <<
        mutabilis integer value;
    >>.
    mutabilis Inner center;
>>.
Outer.Inner inner <- novum 4.
Outer outer <- novum inner.
outer > center.value <- 8.
Scribe outer, "/linea".
nuntia structuram Empty <<Small <<>>.>>.
Empty.Small empty <- novum nihil.
Scribe empty, "/linea".
