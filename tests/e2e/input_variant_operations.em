nuntia edictum Add quo cape integer value remitteque integer <<
    reditus value + 2!
>>.
variabilis A <- Legere.
variabilis B <- Legere.
variabilis Text <- Legere.
integer Copy <- A.
Scribe A idem B, ",", A idem 10, ",", A idem "10", ",", Text idem "Legere", "/linea".
Scribe A + 1, ",", Add(B), ",", Copy, "/linea".
